# --- Notion (required for sync capabilities) ---
# Personal access token or internal integration token. A sync is not called by an
# agent, so it needs its own token. If using an internal integration, connect it
# to the destination database after the first deploy.
NOTION_API_TOKEN=ntn_xxx

# --- Zapier SDK (headless client credentials) ---
# Generate once on a machine with a browser:
#   npx zapier-sdk create-client-credentials "notion-luma-worker"
# The secret is shown only once — save it immediately.
ZAPIER_CLIENT_ID=
ZAPIER_CLIENT_SECRET=

# --- Google Drive ---
# The ID of the folder that receives the Luma "Guests" CSV exports.
# Open the folder in Drive; the ID is the last path segment of the URL:
#   https://drive.google.com/drive/folders/<THIS_IS_THE_FOLDER_ID>
GDRIVE_FOLDER_ID=

# Optional: override the Zapier app slug for the Drive connection (default: google-drive)
# ZAPIER_GDRIVE_APP=google-drive
