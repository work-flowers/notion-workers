# Supercut PERSONAL API token (sk_u_…) — Settings → "Personal API Tokens".
# A workspace token (sk_…) authenticates but sees no user-owned playlists or
# recordings (200 with zero items / 403), so the sync would find nothing.
SUPERCUT_API_TOKEN=

# Notion internal integration token. Only needed for the page-body pass that
# writes the embed code block; the integration must be shared with the
# Recordings database.
NOTION_API_TOKEN=

# Data source ID of the worker-managed "Supercut Recordings" database. Only
# knowable AFTER the first deploy has created the database. Until it is set the
# body pass is skipped (rows and covers still sync).
RECORDINGS_DATA_SOURCE_ID=

# public_id of the Supercut "Website" playlist — the publish gate. Only
# recordings in it are synced; the other public playlists set the category.
WEBSITE_PLAYLIST_ID=KNa7tQVRfXvdwBqqj6M1Jj
