# Zapier SDK client credentials (npx zapier-sdk create-client-credentials).
ZAPIER_CLIENT_ID=
ZAPIER_CLIENT_SECRET=

# Zapier YouTube connection authorised to the channel being synced.
ZAPIER_YOUTUBE_CONNECTION_ID=

# Notion integration token for the link pass. It must be able to read Supercut
# Recordings and read/write YouTube Videos.
NOTION_API_TOKEN=

# Data source id of the worker-managed "YouTube Videos" database. Only knowable
# AFTER the first deploy; until it is set the link pass is skipped.
VIDEOS_DATA_SOURCE_ID=
